        <con:content>openapi: '3.1.0'
info:
  title: Connected Vehicles Services API
  version: '1.0.0'
  description: API for managing vehicle telemetry data, remote commands, and over-the-air software updates.
servers:
  - url: https://api.example.com/v1
paths:
  /vehicles:
    get:
      summary: Get a list of vehicles
      responses:
        '200':
          description: A list of vehicles
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Vehicle'
              example:
                - id: "1"
                  make: "Toyota"
                  model: "Camry"
                  year: 2020
                  type: "fuel"
                - id: "2"
                  make: "Honda"
                  model: "Civic"
                  year: 2019
                  type: "fuel"
                - id: "3"
                  make: "Ford"
                  model: "Focus"
                  year: 2018
                  type: "electric"
                - id: "4"
                  make: "Chevrolet"
                  model: "Malibu"
                  year: 2021
                  type: "hybrid"
        '500':
          description: Server error
    post:
      summary: Create a new vehicle
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Vehicle'
      responses:
        '201':
          description: Vehicle created successfully
        '400':
          description: Invalid input
        '500':
          description: Server error

  /vehicles/{vehicleId}:
    get:
      summary: Get a vehicle by ID
      parameters:
        - name: vehicleId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: A single vehicle
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Vehicle'
              example:
                id: "1"
                make: "Toyota"
                model: "Camry"
                year: 2020
                type: "fuel"
        '404':
          description: Vehicle not found
        '500':
          description: Server error
    put:
      summary: Update a vehicle
      parameters:
        - name: vehicleId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Vehicle'
      responses:
        '200':
          description: Vehicle updated successfully
        '400':
          description: Invalid input
        '404':
          description: Vehicle not found
        '500':
          description: Server error
    delete:
      summary: Delete a vehicle
      parameters:
        - name: vehicleId
          in: path
          required: true
          schema:
            type: string
      responses:
        '204':
          description: Vehicle deleted successfully
        '404':
          description: Vehicle not found
        '500':
          description: Server error

  /vehicles/{vehicleId}/commands:
    post:
      summary: Send a remote command to a vehicle
      parameters:
        - name: vehicleId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RemoteCommand'
      responses:
        '200':
          description: Command sent successfully
        '400':
          description: Invalid command
        '404':
          description: Vehicle not found
        '500':
          description: Server error

  /vehicles/{vehicleId}/software-update:
    post:
      summary: Initiate a software update for a vehicle
      parameters:
        - name: vehicleId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SoftwareUpdate'
      responses:
        '200':
          description: Software update initiated successfully
        '400':
          description: Invalid update request
        '404':
          description: Vehicle not found
        '500':
          description: Server error

  /audit-logs:
    get:
      summary: Get a list of audit logs
      responses:
        '200':
          description: A list of audit logs
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AuditLog'
              example:
                - id: "1"
                  action: "CREATE"
                  timestamp: "2023-10-01T12:00:00Z"
                  vehicleId: "1"
                - id: "2"
                  action: "UPDATE"
                  timestamp: "2023-10-02T12:00:00Z"
                  vehicleId: "2"
                - id: "3"
                  action: "DELETE"
                  timestamp: "2023-10-03T12:00:00Z"
                  vehicleId: "3"
                - id: "4"
                  action: "COMMAND"
                  timestamp: "2023-10-04T12:00:00Z"
                  vehicleId: "4"
        '500':
          description: Server error

components:
  schemas:
    Vehicle:
      type: object
      required:
        - id
        - make
        - model
        - year
        - type
      properties:
        id:
          type: string
        make:
          type: string
        model:
          type: string
        year:
          type: integer
        type:
          type: string
          enum: [electric, hybrid, fuel]
    RemoteCommand:
      type: object
      required:
        - commandType
      properties:
        commandType:
          type: string
          enum: [lock, unlock, start, stop]
    SoftwareUpdate:
      type: object
      required:
        - version
      properties:
        version:
          type: string
    AuditLog:
      type: object
      required:
        - id
        - action
        - timestamp
        - vehicleId
      properties:
        id:
          type: string
        action:
          type: string
        timestamp:
          type: string
          format: date-time
        vehicleId:
          type: string</con:content>
        <con:type>https://swagger.io/openapiv3/specification</con:type>
      </con:part>
    </con:definitionCache>
